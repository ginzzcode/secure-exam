# Frontend environment variables for the Supabase client.
#
# Copy this file to .env.local and fill in the values for the target environment.
# Only the Supabase project URL and the publishable (anon) key belong here.
#
# Never place a service-role key, a secret key, or any privileged backend
# credential in a VITE_ variable. Vite inlines every VITE_ variable into the
# browser bundle. The build-time bundle scan fails if one is detected.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
